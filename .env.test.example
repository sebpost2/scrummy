# Copy to .env.test — used by the test suite (tests/setup.ts) and, when
# present, by the Prisma CLI (prisma.config.ts) for `migrate dev` / `reset`.
#
# This MUST be a throwaway database, never production/dev. The suite creates
# and deletes rows on every run. Recommended: a separate Neon project/branch,
# or a Claimable Neon instance via the `neon` skill for a zero-signup
# throwaway Postgres.
#
DATABASE_URL=""
APP_URL="http://localhost:3000"
