# PostgreSQL connection string
# Example: postgres://user:password@host:port/database?sslmode=verify-full
# Use sslmode=verify-full explicitly — pg's "require"/"prefer"/"verify-ca" are
# only aliases for verify-full today and will lose that meaning in pg v9.
DATABASE_URL=""

# Canonical origin of this app, e.g. http://localhost:3000 or https://scrummy.example.com
# Used to build the OAuth redirect_uri and post-login redirects; must match the
# scheme + host of the redirect URI registered in Google.
APP_URL=""

# Google OAuth credentials (APIs & Services -> Credentials -> OAuth client ID)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
